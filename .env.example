# Public, browser-safe configuration only. Do not place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Neon) ---
# Pooled connection — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full&channel_binding=require"
# Same endpoint without "-pooler" — used by `prisma migrate` only, because
# PgBouncer cannot hold the advisory locks the schema engine takes.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=verify-full&channel_binding=require"

# --- Auth0 (@auth0/nextjs-auth0 v4) ---
# Regular Web Application credentials. Copy to .env and set real values.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
# Generate with: openssl rand -hex 32. Also derives the session-row encryption key.
AUTH0_SECRET=replace_with_a_32_byte_hex_secret
AUTH_SECRET=

# --- AI and research providers ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
EXA_API_KEY=

# --- Background-worker and integration services ---
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=

# Optional: restrict cross-origin API calls outside local development.
ALLOWED_ORIGINS=http://localhost:3000
