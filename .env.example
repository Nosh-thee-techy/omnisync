# Public, browser-safe configuration only. Do not place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth0 Regular Web Application credentials. Copy to .env.local and set real values.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
# Generate with: openssl rand -hex 32
AUTH0_SECRET=replace_with_a_32_byte_hex_secret
APP_BASE_URL=http://localhost:3001

# Database and authentication
DATABASE_URL=
AUTH_SECRET=

# AI and research providers
OPENAI_API_KEY=
OPENROUTER_API_KEY=
EXA_API_KEY=

# Background-worker and integration services
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=

# Optional: restrict cross-origin API calls outside local development.
ALLOWED_ORIGINS=http://localhost:3000
