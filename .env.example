# Neon pooled connection — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full&channel_binding=require"

# Same endpoint without "-pooler" — used by `prisma migrate` only
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=verify-full&channel_binding=require"
