# Copy to .env and fill in real values. Every variable below is read by the
# code; anything the app does not read has been removed.

# --- Database (Neon) ---
# Pooled connection — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full&channel_binding=require"
# Same endpoint without "-pooler" — used by `prisma migrate` only, because
# PgBouncer cannot hold the advisory locks the schema engine takes.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=verify-full&channel_binding=require"

# --- Auth0 (@auth0/nextjs-auth0 v4) ---
# Must match the Allowed Callback URL registered on the Auth0 application:
# ${APP_BASE_URL}/auth/callback
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
# Generate with: openssl rand -hex 32
# Encrypts the session cookie, and derives the key for the encrypted session
# rows in Postgres — rotating it invalidates every active session.
AUTH0_SECRET=replace_with_a_32_byte_hex_secret

# --- OpenRouter (transcript intent extraction) ---
# Without this key, parseIntentFromTranscript() silently falls back to the
# local heuristic parser — no error is raised.
OPENROUTER_API_KEY=
# Optional. Defaults shown; the parser falls back to
# meta-llama/llama-3.1-8b-instruct:free if the primary model fails.
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=OmniSync

# --- Google Meet connection (src/app/api/auth/google) ---
# Not a sign-in path — this flow proves the user can grant Meet access and
# creates no session. Authentication is Auth0's job.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorised redirect URI on the Google OAuth client:
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Exa (RESEARCH_QUERY dispatch) ---
# Without this key, research dispatch returns a placeholder result instead of
# live web search.
EXA_API_KEY=

# --- Trigger.dev (background dispatch) ---
# 1. `npx trigger.dev@latest login`
# 2. Create/select a project — copy the project ref below
# 3. `npm run trigger:deploy` (deploys tasks to prod)
# 4. Copy the PROD secret key from Trigger.dev → API Keys
# When TRIGGER_SECRET_KEY is set, approve & dispatch queues on Trigger.dev.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
