# Public, browser-safe configuration only. Do not place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database and authentication
DATABASE_URL=
AUTH_SECRET=

# AI and research providers
OPENAI_API_KEY=
OPENROUTER_API_KEY=
EXA_API_KEY=

# Background-worker and integration services
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=

# Optional: restrict cross-origin API calls outside local development.
ALLOWED_ORIGINS=http://localhost:3000
